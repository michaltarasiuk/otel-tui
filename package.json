{
  "name": "otel-tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "check:fix": "bun run lint:fix && bun run format",
    "gen:traces": "telemetrygen traces --otlp-http --otlp-insecure --traces 10",
    "gen:metrics": "telemetrygen metrics --otlp-http --otlp-insecure --metrics 10",
    "gen:logs": "telemetrygen logs --otlp-http --otlp-insecure --logs 10",
    "demo:up": "demo/demo.sh up",
    "demo:down": "demo/demo.sh down"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@opentui/core": "^0.6.6",
    "@opentui/keymap": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.3",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": ">=1.3",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.3"
  }
}
